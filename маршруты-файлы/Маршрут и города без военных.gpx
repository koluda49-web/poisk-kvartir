<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="marshrut" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata><name>Маршрут и города (без военных)</name></metadata>
  <wpt lat="53.904500" lon="27.566700">
    <name>Минск</name>
    <desc>Старт · Начало маршрута. Выезд по трассе М1 (Е30) в направлении Бреста.</desc>
  </wpt>
  <wpt lat="53.030000" lon="25.342000">
    <name>Свято-Успенский Жировичский монастырь</name>
    <desc>Монастырь · XVII–XVIII вв. · Один из главных православных центров Беларуси, крупнейший архитектурный ансамбль XVII–XVIII вв. Здесь хранится чудотворная Жировичская икона Божией Матери. В зените славы монастырь называли «новой Ченстоховой» Речи Посполитой. Комплекс включает Успенский собор, Явленскую и Крестовоздвиженскую церкви, здание семинарии. Крюк ~12 км с трассы М1 у Слонима.</desc>
  </wpt>
  <wpt lat="52.765600" lon="25.121700">
    <name>Коссовский замок (Дворец Пусловских)</name>
    <desc>Замок · Дворец Пусловских · XIX в. · Неоготический дворец 1838 года — «Рыцарская греза» с 12 башнями, 132 комнатами и легендарным стеклянным полом над аквариумом. Первый в Беларуси дворец с центральным отоплением. Отреставрирован, открыт для посещения. Рядом — музей-усадьба Тадеуша Костюшко. Съезд с М1 на Ивацевичи, затем ~20 км по Р44.</desc>
  </wpt>
  <wpt lat="52.860000" lon="24.896100">
    <name>Дворцовый комплекс Сапег</name>
    <desc>Дворец · Резиденция Сапег · XVII–XVIII вв. · Резиденция канцлера ВКЛ Льва Сапеги, перестроенная в 1784–1786 гг. Сохранились въездные ворота-триумф, флигели и руины главного корпуса. По легенде, подземный ход соединял дворец с Коссовским замком.</desc>
  </wpt>
  <wpt lat="52.869818" lon="24.896822">
    <name>Костёл Святого Казимира</name>
    <desc>Костёл · Католический храм · Католический храм в Ружанах. Святой Казимир — покровитель города, его образ присутствует на гербе Ружан.</desc>
  </wpt>
  <wpt lat="52.865102" lon="24.888417">
    <name>Синагога, Ружаны</name>
    <desc>Синагога · Историческое место · Историческая синагога — свидетель многовековой еврейской истории Ружан. Напоминает о богатом многоконфессиональном прошлом местечка.</desc>
  </wpt>
  <wpt lat="52.493652" lon="24.480072">
    <name>Усадебный дом, Пружаны</name>
    <desc>Усадьба · XIX в. · Пружаны · Исторический усадебный дом XIX века. Крюк через Пружаны также позволяет увидеть сам город с его церквями и застройкой эпохи Российской империи.</desc>
  </wpt>
  <wpt lat="52.097600" lon="23.688400">
    <name>Брест</name>
    <desc>Промежуточный финиш · Далее маршруты по городу и окрестностям · Промежуточная точка маршрута и отдельный день осмотра. Кроме объектов ниже — пешеходный бульвар Гоголя, Свято-Симеоновский собор XIX в. и Музей спасённых ценностей в центре города.</desc>
  </wpt>
  <wpt lat="52.082193" lon="23.656051">
    <name>Брестская крепость</name>
    <desc>Крепость · 1836–1842 гг. · Мемориал · Крепость первого класса, заложенная в 1830-х на месте старого города Берестье, который ради стройки полностью перенесли на новое место. Мемориальный комплекс открыт в 1971 году: Цитадель, руины Белого дворца, монумент «Мужество», штык-обелиск, Вечный огонь и Холмские ворота со следами обстрела 1941 года. Осмотр всей территории — минимум 2–3 часа.</desc>
  </wpt>
  <wpt lat="52.080170" lon="23.654623">
    <name>Археологический музей «Берестье»</name>
    <desc>Музей · Археология · XI–XIII вв. · Единственный в Европе музей средневекового восточнославянского города, показанный прямо на месте раскопа. Под куполом павильона — вскрытый культурный слой с деревянными срубами XI–XIII веков, улицами и мостовыми древнего Берестья. Находится на Волынском укреплении крепости.</desc>
  </wpt>
  <wpt lat="52.077304" lon="23.659118">
    <name>Южные ворота</name>
    <desc>Ворота · Укрепления крепости · Въездные ворота южной части крепостных укреплений — сохранившийся элемент оборонительного обвода Волынского укрепления. Кирпичная арка с казематами по бокам, характерный образец фортификации середины XIX века.</desc>
  </wpt>
  <wpt lat="52.079036" lon="23.658283">
    <name>Монастырь бернардинок: жилой корпус</name>
    <desc>Монастырь · 2-я половина XVIII в. · Жилой корпус монастыря бернардинок второй половины XVIII века — один из немногих уцелевших фрагментов застройки старого Берестья, оказавшегося внутри крепостных стен. Сохранился частично; здание пережило и снос старого города, и бои 1941 года.</desc>
  </wpt>
  <wpt lat="52.091802" lon="23.686577">
    <name>Межевой знак</name>
    <desc>Межевой знак · 1836 г. · Каменный столб 1836 года — редкий уцелевший пограничный знак эпохи строительства крепости, отмечавший границу отведённых под неё земель. Маленький, неприметный объект для тех, кто любит детали: стоит вне туристических троп.</desc>
  </wpt>
  <wpt lat="52.404756" lon="23.819537">
    <name>Башня-донжон «Белая вежа», Каменец</name>
    <desc>Башня-донжон · XIII в. · Каменец · Белокаменная оборонительная башня 1271–1289 гг. постройки — один из редчайших сохранившихся памятников волынской школы оборонного зодчества. Высота 30 метров, стены толщиной до 2,5 м. Дала название Беловежской пуще. Внутри — музей с экспозицией о средневековом укреплённом городе.</desc>
  </wpt>
  <wpt lat="52.466705" lon="24.098376">
    <name>Музей «Успаміны Бацькаўшчыны»</name>
    <desc>Музей · Народный быт · Пружанский район · д. Стойлы, д. 22, Пружанский район · Сельский частный музей народного быта и памяти родного края. Собранная коллекция предметов повседневной жизни белорусской деревни XIX–XX веков воссоздаёт атмосферу ушедшего времени.</desc>
  </wpt>
  <wpt lat="52.856319" lon="24.614780">
    <name>Костёл, Лысково</name>
    <desc>Костёл · д. Лысково · Исторический католический храм в деревне Лысково — памятник сакральной архитектуры Брестчины.</desc>
  </wpt>
  <wpt lat="52.960755" lon="24.557563">
    <name>Усадьба Сегеней, Краски</name>
    <desc>Усадьба · д. Краски · Историческая усадьба в деревне Краски — памятник усадебной архитектуры Гродненщины.</desc>
  </wpt>
  <wpt lat="52.977486" lon="24.620204">
    <name>Усадьба, Подороск</name>
    <desc>Усадьба · д. Подороск · Усадебный дом в деревне Подороск — исторический объект на пути из Лыскова к Волковыску.</desc>
  </wpt>
  <wpt lat="53.158914" lon="24.471595">
    <name>Костёл, Волковыск</name>
    <desc>Костёл · Волковыск · Исторический католический храм в Волковыске — памятник сакральной архитектуры города.</desc>
  </wpt>
  <wpt lat="53.161489" lon="24.473429">
    <name>Дом Багратиона, Волковыск</name>
    <desc>Историческое место · Волковыск · Исторический дом, связанный с именем князя Петра Багратиона — прославленного российского полководца эпохи наполеоновских войн, который квартировал в Волковыске в период военных кампаний.</desc>
  </wpt>
  <wpt lat="53.349684" lon="24.408898">
    <name>Усадебный дом, Дубовцы</name>
    <desc>Усадьба · д. Дубовцы · Усадебный дом в деревне Дубовцы — исторический объект на финальном отрезке пути к Гродно.</desc>
  </wpt>
  <wpt lat="53.688400" lon="23.835000">
    <name>Гродно</name>
    <desc>Промежуточный финиш · дальше петля на Минск · Один из старейших городов Беларуси с богатейшим архитектурным наследием: Старый и Новый замки, Фарный костёл, Борисоглебская (Коложская) церковь XII века, Августовский канал.</desc>
  </wpt>
  <wpt lat="53.410170" lon="24.546346">
    <name>Подвесной мост через Неман</name>
    <desc>Подвесной мост · 1973 г. · Мосты · г. Мосты, Гродненская область · Самый длинный подвесной мост Беларуси — 193,3 метра. Пешеходная переправа через Неман, построенная в 1973 году: качается под шагами, отлично снимается с берега и с середины пролёта. Город так и называется — Мосты.</desc>
  </wpt>
  <wpt lat="53.536990" lon="24.732552">
    <name>Костёл, Рожанка</name>
    <desc>Костёл · конец XVI в. (?), 1674 г. · д. Рожанка, Щучинский р-н · Неоготический костёл Святого Петра и Павла в небольшой деревне — один из самых нарядных сельских храмов Гродненщины. Ранняя история восходит к концу XVI века, каменное здание известно с 1674 года.</desc>
  </wpt>
  <wpt lat="53.600901" lon="24.957504">
    <name>Дворец Четвертинских</name>
    <desc>Дворец · Род Четвертинских · 1908 г. · пос. Желудок, Щучинский р-н · Родовой дворец княжеского рода Четвертинских, построенный в 1908 году. Именно здесь снимали «Дикую охоту короля Стахи». Территория обнесена забором, дворец закрыт на замок, на бывшем военном КПП сидит сторож — через забор лезть не стоит, а вот об экскурсии с ним вполне можно договориться.</desc>
  </wpt>
  <wpt lat="53.602593" lon="24.975985">
    <name>Костёл, Желудок</name>
    <desc>Костёл · 1853 (по другим данным 1854) г. · пос. Желудок, Щучинский р-н · Костёл Вознесения Девы Марии середины XIX века в центре местечка — вторая остановка в Желудке, в паре километров от дворца.</desc>
  </wpt>
  <wpt lat="53.627040" lon="25.027288">
    <name>Усадьба Грабовских</name>
    <desc>Усадьба · д. Дикушки · д. Дикушки, Щучинский р-н · Усадебный дом Грабовских — тихая помещичья усадьба по пути из Желудка к Лиде. Заезд короткий, объект в стороне от туристических потоков.</desc>
  </wpt>
  <wpt lat="53.887131" lon="25.302564">
    <name>Лидский замок</name>
    <desc>Замок · XIV в. · Лида · г. Лида · Замок Гедимина — краснокирпичная крепость XIV века, одна из первых каменных твердынь ВКЛ. Отреставрированы башни и стены, внутри двор с экспозицией, летом проходят рыцарские турниры и фестивали. Главная точка последнего отрезка перед Минском.</desc>
  </wpt>
  <wpt lat="52.091211" lon="23.692230">
    <name>Часы «Время зажжения фонарей» и брестский фонарщик</name>
    <desc>ритуал · ул. Советская · Каждый вечер фонарщик в тёмно-синем мундире зажигает вручную 17 керосиновых фонарей на Советской. Время зажжения совпадает с закатом и меняется каждый день — оно выведено на этих часах в начале улицы. Приходить лучше за 10–15 минут до заката: обход занимает около получаса. Традиция возрождена в 2009 году, бессменный фонарщик — Виктор Кирисюк. Примета: подержаться за пуговицу на его мундире и загадать желание. Утром он фонари гасит — зрителей в разы меньше.</desc>
  </wpt>
  <wpt lat="52.088355" lon="23.692606">
    <name>Скульптура «Любовник» и знак «Место для поцелуев»</name>
    <desc>скульптура · ул. Дзержинского, 21 · Фигура мужчины, вылезающего из окна второго этажа, — по мотивам городской легенды о незадачливом любовнике. Рядом на стене дорисованы остальные участники сцены. С 13 февраля 2016 года тут же висит знак «Место для поцелуев», сделанный под дорожный: Брест стал первым городом Беларуси с таким знаком.</desc>
  </wpt>
  <wpt lat="52.093996" lon="23.692077">
    <name>«Счастливый сапог»</name>
    <desc>скульптура · ул. Советская, 34 · Бронзовый сапог, в который можно влезть ногой. По легенде о брестских «счастливых сапогах» сын горожанки Анны Александровны нашёл в сапоге семь золотых царских червонцев и разбогател. Примета: примеряя сапог, нащупать спрятанные внутри монеты. Установлен 7 сентября 2013 года.</desc>
  </wpt>
  <wpt lat="52.088800" lon="23.695076">
    <name>«Пуговица фонарщика»</name>
    <desc>арт-объект · ул. Гоголя · Отдельный арт-объект — та самая пуговица, за которую загадывают желание. Удобно, если фонарщика вы не застали: пуговица на месте круглые сутки.</desc>
  </wpt>
  <wpt lat="52.092795" lon="23.692994">
    <name>Памятник Тысячелетия Бреста</name>
    <desc>памятник · ул. Советская · Многофигурная композиция 2009 года: наверху ангел-хранитель, ниже — князь Владимир Василькович, Витовт, Николай Радзивилл Чёрный, летописец, безымянные мать и солдат. Главная точка встречи на пешеходной улице.</desc>
  </wpt>
  <wpt lat="52.091588" lon="23.693828">
    <name>Инсталляция «Любовь есть»</name>
    <desc>арт-объект · ул. Советская · Небольшая городская инсталляция на пешеходной улице — популярная фототочка рядом с художественной галереей.</desc>
  </wpt>
  <wpt lat="52.085341" lon="23.682334">
    <name>Лавочка примирения</name>
    <desc>скульптура · бульвар Шевченко · Скамья с наклонными половинами: сесть по краям и не съехать к середине невозможно — на том и построена задумка мириться.</desc>
  </wpt>
  <wpt lat="52.095898" lon="23.690084">
    <name>«Старый город» (кошки)</name>
    <desc>арт-объект · ул. Советская · Композиция со скульптурами кошек, обыгрывающая старый Брест. Одна из самых фотографируемых мелочей на улице.</desc>
  </wpt>
  <wpt lat="52.091718" lon="23.687132">
    <name>Аллея кованых фонарей (начало аллеи)</name>
    <desc>аллея · ул. Гоголя · Открыта 27 июля 2013 года, сегодня насчитывает более 40 кованых фонарей, и каждый — отдельный арт-объект: Дон Кихот, ночной дозор, швейная машинка, зубр, купидон, чистильщик обуви, шмель. Часть фонарей обыгрывает произведения Гоголя, часть — профиль предприятия-спонсора. Около трети выковал скульптор Александр Чумаков. Идти вдоль всей улицы — вечером фонари подсвечены.</desc>
  </wpt>
  <wpt lat="52.086684" lon="23.686331">
    <name>Музей «Спасённые художественные ценности»</name>
    <desc>музей · ул. Ленина, 39 · Единственный в Беларуси музей, собранный из вещей, задержанных таможней при попытке вывоза: иконы, живопись, ювелирка, самовары, часы.</desc>
  </wpt>
  <wpt lat="52.085655" lon="23.672189">
    <name>Брестский музей железнодорожной техники</name>
    <desc>музей · пр. Машерова, 2 · Открытая площадка с паровозами, вагонами и путевой техникой — более полусотни единиц. В некоторые кабины пускают.</desc>
  </wpt>
  <wpt lat="52.090129" lon="23.689331">
    <name>Брестский областной краеведческий музей</name>
    <desc>музей · ул. К. Маркса, 60 · Основная экспозиция об истории города и области — хороший вводный час перед прогулкой по центру.</desc>
  </wpt>
  <wpt lat="53.678143" lon="23.824600">
    <name>Пожарная каланча с фреской</name>
    <desc>фреска · ул. Замковая, 19 · На стене каланчи 1912 года — большая роспись с гродненскими пожарными разных эпох. Городская загадка: среди мужских лиц художник спрятал женское, похожее на Мону Лизу. Ищите сами, подсказок на месте нет. Внутри — музей пожарной службы, рядом скульптура пожарного.</desc>
  </wpt>
  <wpt lat="53.685948" lon="23.844594">
    <name>Лягушка-путешественница</name>
    <desc>скульптура · ул. Ожешко, у ж/д вокзала · Стоит с 2009 года. В 2016-м кто-то отломал ей палку с узелком — скульптор Владимир Пантелеев восстановил фигуру и добавил сундучок-копилку. С тех пор туристы бросают туда монеты и загадывают желания.</desc>
  </wpt>
  <wpt lat="53.683993" lon="23.835969">
    <name>Скамейка любви</name>
    <desc>скамейка · парк Жилибера · Парная скамья в парке — обязательная фототочка молодожёнов Гродно вместе со «Скамейкой примирения» неподалёку.</desc>
  </wpt>
  <wpt lat="53.684002" lon="23.836625">
    <name>Скамейка примирения</name>
    <desc>скамейка · парк Жилибера · Гродненский аналог брестской: сиденья скошены к центру, так что мириться придётся в буквальном смысле. От «Скамейки любви» — тридцать метров.</desc>
  </wpt>
  <wpt lat="53.682656" lon="23.832296">
    <name>Купидон</name>
    <desc>скульптура · центр города · Маленький бронзовый купидон — одна из тех городских мелочей, которые замечаешь, только если знаешь, что искать.</desc>
  </wpt>
  <wpt lat="53.684535" lon="23.834708">
    <name>Скамья архитекторов</name>
    <desc>скульптура · площадь Тызенгауза · Композиция в честь создателей облика Гродно. В руках у одной из фигур — оригинальный план города 1780 года, найденный в военно-историческом архиве в Москве.</desc>
  </wpt>
  <wpt lat="53.674738" lon="23.838078">
    <name>«Учёный кот»</name>
    <desc>скульптура · ул. Свердлова, 2 · Кот с книгой — местная традиция потереть скульптуру на удачу перед экзаменом или дорогой.</desc>
  </wpt>
  <wpt lat="53.676789" lon="23.838342">
    <name>Кот Матроскин и почтальон Печкин</name>
    <desc>скульптура · ул. Советская · Простоквашинская парочка в пешеходном центре — самая детская фототочка Гродно.</desc>
  </wpt>
  <wpt lat="53.684290" lon="23.836131">
    <name>«Я люблю тебя, Гродно!»</name>
    <desc>арт-объект · парк Жилибера · Объёмная надпись в парке — стандартная, но работающая точка для общего кадра.</desc>
  </wpt>
  <wpt lat="53.685987" lon="23.835413">
    <name>Памятник Жану Эммануэлю Жилиберу</name>
    <desc>памятник · парк Жилибера · Французский ботаник и медик, основавший в Гродно в 1775 году врачебную академию и ботанический сад. Парк, названный его именем, вырос из того самого сада — старейшего в стране.</desc>
  </wpt>
  <wpt lat="53.707567" lon="23.843595">
    <name>Скульптуры героев фильма «Белые Росы»</name>
    <desc>скульптура · микрорайон Девятовка, ул. Дзержинского / Курчатова · Деревянные фигуры Фёдора (Федоса) Ходаса, соседа Тимофея и пса Валета установлены в 2018 году на месте съёмок фильма 1983 года. Рядом — тот самый колодец из кадра. Крюк от центра, но для любителей кино обязателен.</desc>
  </wpt>
  <wpt lat="53.678197" lon="23.831613">
    <name>Фарный костёл — собор Святого Франциска Ксаверия</name>
    <desc>костёл · орган · Советская площадь, 4 · Тот самый костёл с органом. Бывший иезуитский, освящён в 1705 году: главный фасад с двумя башнями — позднее барокко с рококо, внутри 21 резной алтарь в позолоте и деревянный главный алтарь высотой с многоэтажный дом. Здесь регулярно проходят органные концерты — расписание вывешено у входа и на сайте прихода. Стоит в самом центре, на Советской площади.</desc>
  </wpt>
  <wpt lat="53.678409" lon="23.818551">
    <name>Борисоглебская (Коложская) церковь</name>
    <desc>церковь · XII в. · ул. Коложа, 8 · Одна из древнейших сохранившихся построек Беларуси — XII век, домонгольское зодчество. В стены вмурованы полированные валуны и керамические голосники. Часть храма обрушилась в Неман в 1853 году, поэтому одна стена деревянная. Стоит на высоком берегу — лучший вид на Неман в городе.</desc>
  </wpt>
  <wpt lat="53.674795" lon="23.830230">
    <name>Костёл Обретения Святого Креста и монастырь бернардинцев</name>
    <desc>костёл · орган · ул. Парижской Коммуны, 1 · Один из старейших действующих костёлов города, строился с конца XVI века. Здесь тоже есть орган и проходят концерты — если органный костёл, который вы вспоминаете, стоит не на площади, а ближе к Неману, то это он.</desc>
  </wpt>
  <wpt lat="53.687063" lon="23.840521">
    <name>Лютеранская кирха Святого Иоанна</name>
    <desc>кирха · орган · ул. Академическая, 7а · Единственная действующая лютеранская кирха Беларуси, неоготика XIX века. Небольшая, с органом; концерты бывают реже, но акустика камерная и очень чистая.</desc>
  </wpt>
  <wpt lat="53.684498" lon="23.841407">
    <name>Свято-Покровский кафедральный собор</name>
    <desc>собор · ул. Ожешко, 23 · Главный православный собор города, построен в 1904–1907 годах как гарнизонный храм в память о погибших в русско-японской войне. Ретроспективно-русский стиль, шатровая колокольня.</desc>
  </wpt>
  <wpt lat="53.671985" lon="23.822247">
    <name>Костёл Девы Марии Ангельской и монастырь францисканцев</name>
    <desc>костёл · ул. Огородная, 5 · Барочный костёл XVII века на другом берегу Немана, с монастырским корпусом. Тихое место с видом на город — почти без туристов.</desc>
  </wpt>
  <wpt lat="53.677132" lon="23.826648">
    <name>Церковь Рождества Богородицы</name>
    <desc>церковь · ул. Давыда Городенского, 5 · Барочная церковь бывшего базилианского монастыря XVIII века, рядом с Большой хоральной синагогой — два храма в двух шагах друг от друга.</desc>
  </wpt>
  <wpt lat="53.679067" lon="23.825073">
    <name>Большая хоральная синагога</name>
    <desc>синагога · ул. Большая Троицкая, 59а · Одна из старейших синагог Беларуси: община на этом месте с XVI века, нынешнее здание — начала XX века. Восстановлена, действует, внутрь пускают.</desc>
  </wpt>
  <wpt lat="53.684994" lon="23.840073">
    <name>Корпус ГрГУ имени Янки Купалы, увитый диким виноградом</name>
    <desc>здание · ул. Ожешко, 22 · Бывшая Мариинская женская гимназия конца XIX века, фасад полностью затянут девичьим виноградом. Первые лозы вдоль чугунной ограды высадили ещё гимназистки в XIX веке. Летом стена ярко-зелёная, в сентябре–октябре становится багрово-красной — тогда сюда и стоит приходить за кадром.</desc>
  </wpt>
  <wpt lat="53.869476" lon="23.757476">
    <name>Августовский канал · шлюз «Немново»</name>
    <desc>канал · XIX в. · д. Немново, ~35 км от Гродно · Судоходный канал 1824–1839 годов, соединивший Неман с Вислой, — памятник гидротехники, часть которого действует до сих пор. «Немново» — самый эффектный узел на белорусском участке: четырёхкамерный шлюз, единственный такой на канале. Летом ходят прогулочные теплоходы, рядом велодорожки и байдарки. Отдельная поездка на полдня из Гродно.</desc>
  </wpt>
  <wpt lat="53.678484" lon="23.831129">
    <name>Аптека-музей</name>
    <desc>музей · Советская площадь, 4 · Аптека иезуитского коллегиума — старейшая в Беларуси, работает с XVIII века и по сей день. Одна половина — действующая аптека, вторая — музей с рецептурными книгами, склянками и старой мебелью.</desc>
  </wpt>
  <wpt lat="53.677827" lon="23.825753">
    <name>Музей истории религии</name>
    <desc>музей · ул. Замковая, 16 · Единственный в Беларуси музей такого профиля: конфессиональная история страны от язычества до XX века, в барочном дворце Кароля Хрептовича.</desc>
  </wpt>
  <wpt lat="53.708177" lon="23.839407">
    <name>Музей автозаправочных колонок</name>
    <desc>музей · ул. Победы · Частная коллекция бензоколонок разных эпох под открытым небом — редкая городская странность, которую стоит увидеть по дороге из города.</desc>
  </wpt>
</gpx>
